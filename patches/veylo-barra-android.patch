+import 'dart:async';
+
+import 'package:flutter_riverpod/flutter_riverpod.dart';
+import 'package:fluxer_app/core/theme/fluxer_theme_extension.dart';
+import 'package:fluxer_app/features/profile/presentation/widgets/profile_appearance.dart';
+import 'package:fluxer_app/features/settings/presentation/user_settings_modal.dart';
+import 'package:fluxer_app/features/settings/providers/view_models/user_settings_view_model.dart';
+import 'package:fluxer_app/features/ui/icons/plutonium_product_icon.dart';
+import 'package:fluxer_app/features/ui/tappable/fluxer_tappable.dart';
+import 'package:fluxer_app/features/ui/ui.dart'
+    show FluxerPageSheet, FluxerPageSheetPresentation;
+import 'package:fluxer_app/l10n/generated/fluxer_localizations.dart';
+import 'package:fluxer_app/material_ui.dart';
+import 'package:fluxer_app/shared/icons/phosphor.dart';
+
+class VeyloProfileActions extends StatelessWidget {
+  const VeyloProfileActions({required this.appearance, super.key});
+
+  final Map<String, Object?>? appearance;
+
+  @override
+  Widget build(BuildContext context) {
+    final l10n = FluxerLocalizations.of(context);
+    final colors = context.colors;
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(12, 4, 12, 8),
+      child: Material(
+        color: colors.backgroundSecondary,
+        borderRadius: BorderRadius.circular(24),
+        clipBehavior: Clip.antiAlias,
+        child: Ink(
+          decoration: BoxDecoration(
+            color: colors.borderColor.withValues(alpha: 0.22),
+            gradient: profileGradient(appearance),
+          ),
+          child: Row(
+            children: [
+              Expanded(
+                child: _ProfileAction(
+                  icon: kPlutoniumProductIcon,
+                  label: 'Premium',
+                  onTap: () => unawaited(_showVeyloPremium(context)),
+                ),
+              ),
+              Expanded(
+                child: _ProfileAction(
+                  icon: PhosphorIconsFill.gear,
+                  label: l10n.userSettingsTitle,
+                  onTap: () => unawaited(UserSettingsModal.show(context)),
+                ),
+              ),
+            ],
+          ),
+        ),
+      ),
+    );
+  }
+}
+
+class _ProfileAction extends StatelessWidget {
+  const _ProfileAction({
+    required this.icon,
+    required this.label,
+    required this.onTap,
+  });
+
+  final IconData icon;
+  final String label;
+  final VoidCallback onTap;
+
+  @override
+  Widget build(BuildContext context) {
+    final colors = context.colors;
+    return FluxerTappable(
+      onTap: onTap,
+      semanticLabel: label,
+      excludeChildSemantics: true,
+      builder: (context, states) => Padding(
+        padding: const EdgeInsets.symmetric(horizontal: 4, vertical: 10),
+        child: Column(
+          mainAxisSize: MainAxisSize.min,
+          children: [
+            PhosphorIcon(icon, size: 24, color: colors.textChat),
+            const SizedBox(height: 4),
+            Text(
+              label,
+              textAlign: TextAlign.center,
+              maxLines: 2,
+              overflow: TextOverflow.ellipsis,
+              style: context.textStyles.bodySmall.copyWith(
+                color: colors.textChat,
+                fontWeight: FontWeight.w600,
+              ),
+            ),
+          ],
+        ),
+      ),
+    );
+  }
+}
+
+
+Future<void> _showVeyloPremium(BuildContext context) {
+  return FluxerPageSheet.showScrollable<void>(
+    context,
+    title: 'Veylo Premium',
+    presentation: FluxerPageSheetPresentation.root,
+    builder: (context, scrollController, close) => Consumer(
+      builder: (context, ref, child) {
+        final bool active = ref.watch(
+          userSettingsViewModelProvider.select((state) => state.isPremium),
+        );
+        final language = Localizations.localeOf(context).languageCode;
+        final (activeLabel, inactiveLabel, benefits, description) =
+            switch (language) {
+          'es' => (
+            'Premium activo',
+            'Tu cuenta no tiene Premium activo',
+            'Personaliza tu perfil',
+            'Elige los colores del tema y el estilo de tu nombre de visualización desde Ajustes → Perfil.',
+          ),
+          'pt' => (
+            'Premium ativo',
+            'Sua conta não tem Premium ativo',
+            'Personalize seu perfil',
+            'Escolha as cores do tema e o estilo do seu nome de exibição em Configurações → Perfil.',
+          ),
+          _ => (
+            'Premium active',
+            'Premium is inactive on your account',
+            'Customize your profile',
+            'Choose your theme colors and display name style in Settings → Profile.',
+          ),
+        };
+        final colors = context.colors;
+        final textStyles = context.textStyles;
+        return ListView(
+          controller: scrollController,
+          padding: const EdgeInsets.all(20),
+          children: [
+            DecoratedBox(
+              decoration: BoxDecoration(
+                color: colors.backgroundSecondary,
+                borderRadius: BorderRadius.circular(24),
+                gradient: const LinearGradient(
+                  colors: [Color(0xFF252249), Color(0xFF392653)],
+                ),
+              ),
+              child: Padding(
+                padding: const EdgeInsets.all(20),
+                child: Column(
+                  crossAxisAlignment: CrossAxisAlignment.start,
+                  children: [
+                    const PlutoniumProductIcon(
+                      size: 32,
+                      color: Color(0xFFD7C0FF),
+                    ),
+                    const SizedBox(height: 12),
+                    Text(
+                      active ? activeLabel : inactiveLabel,
+                      style: textStyles.bodyMedium.copyWith(
+                        color: const Color(0xFFF7F1FF),
+                        fontWeight: FontWeight.w700,
+                      ),
+                    ),
+                  ],
+                ),
+              ),
+            ),
+            const SizedBox(height: 24),
+            Text(
+              benefits,
+              style: textStyles.bodyMedium.copyWith(
+                color: colors.textChat,
+                fontWeight: FontWeight.w700,
+              ),
+            ),
+            const SizedBox(height: 6),
+            Text(
+              description,
+              style: textStyles.bodyMedium.copyWith(color: colors.textSecondary),
+            ),
+          ],
+        );
+      },
+    ),
+  );
+}
