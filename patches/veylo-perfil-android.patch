+class _ProfileColorPicker extends StatefulWidget {
+  const _ProfileColorPicker({required this.initialValue});
+  final int initialValue;
+
+  @override
+  State<_ProfileColorPicker> createState() => _ProfileColorPickerState();
+}
+
+class _ProfileColorPickerState extends State<_ProfileColorPicker> {
+  static const presets = [0x896168, 0xc19aa2, 0x663eb0, 0x3bad9f, 0x8dbb46];
+  late HSVColor _hsv = HSVColor.fromColor(_intToColor(widget.initialValue));
+  late final TextEditingController _hex =
+      TextEditingController(text: _intToHex(widget.initialValue));
+
+  @override
+  void dispose() {
+    _hex.dispose();
+    super.dispose();
+  }
+
+  void _select(HSVColor value) {
+    setState(() => _hsv = value);
+    _hex.text = _intToHex(_colorToInt(value.toColor()));
+  }
+
+  @override
+  Widget build(BuildContext context) {
+    final selected = _colorToInt(_hsv.toColor());
+    return Padding(
+      padding: const EdgeInsets.fromLTRB(16, 0, 16, 16),
+      child: Column(
+        mainAxisSize: MainAxisSize.min,
+        children: [
+          FluxerBottomSheetHeader(
+            title: 'Elegir un color',
+            trailing: FluxerButton.primary(
+              size: FluxerButtonSize.small,
+              label: 'Seleccionar',
+              onPressed: RegExp(r'^#?[0-9a-fA-F]{6}$').hasMatch(_hex.text)
+                  ? () => Navigator.of(context).pop(selected) : null,
+            ),
+          ),
+          FluxerInput(
+            controller: _hex,
+            label: 'Hexadecimal',
+            inputFormatters: [LengthLimitingTextInputFormatter(7)],
+            onChanged: (text) {
+              final valid = RegExp(r'^#?[0-9a-fA-F]{6}$').hasMatch(text);
+              setState(() {
+                if (valid) _hsv = HSVColor.fromColor(_intToColor(
+                  int.parse(text.replaceFirst('#', ''), radix: 16),
+                ));
+              });
+            },
+          ),
+          const SizedBox(height: 12),
+          Wrap(
+            alignment: WrapAlignment.spaceBetween,
+            spacing: 10,
+            runSpacing: 6,
+            children: [
+              for (final color in [...presets.where((color) => color != selected), selected])
+                FluxerTappable(
+                  onTap: () => _select(HSVColor.fromColor(_intToColor(color))),
+                  semanticLabel: _intToHex(color),
+                  builder: (_, _) => Container(
+                    width: 36,
+                    height: 36,
+                    decoration: BoxDecoration(
+                      color: _intToColor(color),
+                      borderRadius: BorderRadius.circular(6),
+                    ),
+                    child: color == selected ? const PhosphorIcon(PhosphorIconsBold.check, size: 20) : null,
+                  ),
+                ),
+            ],
+          ),
+          const SizedBox(height: 16),
+          ConstrainedBox(
+            constraints: BoxConstraints(
+              maxWidth: (MediaQuery.sizeOf(context).height * .32).clamp(140.0, 270.0).toDouble(),
+            ),
+            child: Column(
+              children: [
+                _ColorArea(
+                  square: true,
+                  hue: _hsv.hue,
+                  saturation: _hsv.saturation,
+                  value: _hsv.value,
+                  onChanged: (saturation, value) =>
+                      _select(_hsv.withSaturation(saturation).withValue(value)),
+                ),
+                const SizedBox(height: 12),
+                _HueSlider(hue: _hsv.hue, trackHeight: 30, onChanged: (hue) => _select(_hsv.withHue(hue))),
+              ],
+            ),
+          ),
+        ],
+      ),
+    );
+  }
+}
diff --git a/lib/features/profile/presentation/widgets/profile_appearance.dart b/lib/features/profile/presentation/widgets/profile_appearance.dart
new file mode 100644
