+import 'dart:math';
+
+import 'package:fluxer_app/features/ui/bottom_sheet/fluxer_bottom_sheet.dart';
+import 'package:fluxer_app/features/ui/color_picker/fluxer_color_picker_field.dart';
+import 'package:fluxer_app/shared/icons/phosphor.dart';
+import 'package:fluxer_app/material_ui.dart';
+
+Map<String, Object?>? _section(Map<String, Object?>? appearance, String key) {
+  final value = appearance?[key];
+  return value is Map<String, Object?> ? value : null;
+}
+
+List<int> _colors(Map<String, Object?>? style) =>
+    (style?['colors'] as List<Object?>? ?? const []).whereType<int>().toList();
+
+Color _color(int rgb) => Color(0xff000000 | rgb);
+
+Gradient? profileGradient(Map<String, Object?>? appearance) {
+  final theme = _section(appearance, 'theme');
+  final primary = theme?['primary'];
+  final accent = theme?['accent'];
+  if (primary is! int || accent is! int) return null;
+  return LinearGradient(
+    begin: Alignment.topLeft,
+    end: Alignment.bottomRight,
+    colors: [_color(primary).withValues(alpha: .33), _color(accent).withValues(alpha: .47)],
+  );
+}
+
+Widget profileName(String name, TextStyle base, Map<String, Object?>? appearance, {int? maxLines, TextOverflow? overflow}) {
+  final style = _section(appearance, 'name_style');
+  final colors = _colors(style).map(_color).toList();
+  if (colors.isEmpty) return Text(name, style: base, maxLines: maxLines, overflow: overflow);
+  final effect = style?['effect'];
+  final font = switch (style?['font']) {
+    'serif' => 'serif',
+    'mono' => 'monospace',
+    'modern' => 'sans-serif',
+    _ => null,
+  };
+  final color = colors.first;
+  final shadow = switch (effect) {
+    'neon' => [Shadow(color: color, blurRadius: 10)],
+    'pop' => [Shadow(color: color.withValues(alpha: .55), offset: const Offset(2, 2))],
+    'cartoon' => [const Shadow(color: Colors.black, offset: Offset(2, 2))],
+    _ => null,
+  };
+  final gradient = colors.length > 1 &&
+      (effect == 'gradient' || effect == 'candy' || effect == 'prism');
+  final text = Text(name, maxLines: maxLines, overflow: overflow, style: base.copyWith(
+    color: gradient ? Colors.white : color,
+    fontFamily: font,
+    shadows: shadow,
+    fontWeight: effect == 'cartoon' ? FontWeight.w900 : null,
+  ));
+  return gradient ? ShaderMask(
+    blendMode: BlendMode.srcIn,
+    shaderCallback: (bounds) => LinearGradient(colors: colors).createShader(bounds),
+    child: text,
+  ) : text;
+}
+
+class ProfileAppearanceEditor extends StatelessWidget {
+  const ProfileAppearanceEditor({
+    required this.appearance,
+    required this.onChanged,
+    required this.displayName,
+    required this.premium,
+    required this.themeSection,
+    this.expanded = false,
+    super.key,
+  });
+
+  final Map<String, Object?>? appearance;
+  final ValueChanged<Map<String, Object?>> onChanged;
+  final String displayName;
+  final bool premium;
+  final bool themeSection;
+  final bool expanded;
+
+  static const palette = [0x7ee7d8, 0x7ccbff, 0x7f8cff, 0xb56dff, 0xf38bd9];
+  static const fonts = {
+    'default': 'Predeterminada', 'modern': 'Moderna', 'serif': 'Clásica', 'mono': 'Monoespaciada',
+  };
+  static const effects = {
+    'solid': 'Liso', 'gradient': 'Degradado', 'neon': 'Neón',
+    'cartoon': 'Dibujo animado', 'pop': 'Pop', 'candy': 'Gominola', 'prism': 'Prisma',
+  };
+
+  @override
+  Widget build(BuildContext context) {
+    final theme = _section(appearance, 'theme');
+    final style = _section(appearance, 'name_style');
+    final primary = theme?['primary'] as int? ?? 0x387daa;
+    final accent = theme?['accent'] as int? ?? 0xb548c4;
+    final font = style?['font'] as String? ?? 'modern';
+    final effect = style?['effect'] as String? ?? 'prism';
+    final savedColors = _colors(style);
+    final colorCount = effect == 'prism' ? 5 : (effect == 'gradient' || effect == 'candy' ? 2 : 1);
+    final colors = List<int>.generate(colorCount, (i) => i < savedColors.length ? savedColors[i] : palette[i]);
+
+    void updateTheme(int primary, int accent) => onChanged({
+      'theme': {'primary': primary, 'accent': accent}, 'name_style': style,
+    });
+    void updateName(String font, String effect, List<int> colors) => onChanged({
+      'theme': theme, 'name_style': {'font': font, 'effect': effect, 'colors': colors},
+    });
+    final title = themeSection ? 'Tema del perfil' : 'Estilo del nombre de visualización';
+    if (!themeSection && !expanded) {
+      return Column(
+        crossAxisAlignment: CrossAxisAlignment.stretch,
+        children: [
+          Text(title, style: Theme.of(context).textTheme.titleMedium),
+          const SizedBox(height: 8),
+          OutlinedButton(
+            onPressed: !premium ? null : () async {
+              var draft = appearance;
+              final result = await FluxerBottomSheet.show<Map<String, Object?>>(
+                context,
+                title: title,
+                builder: (sheetContext, _) => StatefulBuilder(
+                  builder: (context, setSheetState) => SingleChildScrollView(
+                    child: Padding(
+                      padding: const EdgeInsets.all(16),
+                      child: Column(
+                        mainAxisSize: MainAxisSize.min,
+                        children: [
+                          ProfileAppearanceEditor(
+                            appearance: draft,
+                            displayName: displayName,
+                            premium: true,
+                            themeSection: false,
+                            expanded: true,
+                            onChanged: (value) => setSheetState(() => draft = value),
+                          ),
+                          FilledButton(
+                            onPressed: draft == null
+                                ? null : () => Navigator.of(sheetContext).pop(draft),
+                            child: const Text('Seleccionar'),
+                          ),
+                        ],
+                      ),
+                    ),
+                  ),
+                ),
+              );
+              if (context.mounted && result != null) onChanged(result);
+            },
+            child: Row(
+              children: [
+                Expanded(child: Text(
+                  !premium ? 'Premium' : style == null ? 'Personalizar' :
+                    '${fonts[font] ?? font} + ${effects[effect] ?? effect}',
+                )),
+                const PhosphorIcon(PhosphorIconsBold.caretRight, size: 18),
+              ],
+            ),
+          ),
+        ],
+      );
+    }
+
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.start,
+      children: [
+        if (!expanded) Text(title, style: Theme.of(context).textTheme.titleMedium),
+        if (!premium) const Text('Premium') else ...[
+          const SizedBox(height: 8),
+          Container(
+            width: double.infinity,
+            padding: const EdgeInsets.all(16),
+            decoration: BoxDecoration(
+              gradient: profileGradient(appearance),
+              borderRadius: BorderRadius.circular(12),
+              color: Theme.of(context).colorScheme.surface,
+            ),
+            child: profileName(displayName, Theme.of(context).textTheme.titleLarge ?? const TextStyle(), appearance),
+          ),
+          const SizedBox(height: 8),
+          if (themeSection) ...[
+            Row(children: [
+              Expanded(child: _ProfileColorSwatch(label: 'Primario', value: primary, onChanged: (color) => updateTheme(color, accent))),
+              const SizedBox(width: 12),
+              Expanded(child: _ProfileColorSwatch(label: 'Realce', value: accent, onChanged: (color) => updateTheme(primary, color))),
+            ]),
+            if (theme != null)
+              TextButton(onPressed: () => onChanged({'theme': null, 'name_style': style}), child: const Text('Restablecer tema')),
+          ] else ...[
+            _choice('Fuente', font, fonts, (value) => updateName(value, effect, colors)),
+            _choice('Efecto', effect, effects, (value) {
+              final count = value == 'prism' ? 5 : (value == 'gradient' || value == 'candy' ? 2 : 1);
+              updateName(font, value, List.generate(count, (i) => i < colors.length ? colors[i] : palette[i]));
+            }),
+            for (var i = 0; i < colorCount; i++)
+              _ProfileColorSwatch(label: 'Color ${i + 1}', value: colors[i], onChanged: (value) {
+                final next = [...colors]..[i] = value;
+                updateName(font, effect, next);
+              }),
+            TextButton(onPressed: () {
+              final random = Random();
+              updateName(font, 'prism', List.generate(5, (_) => random.nextInt(0x1000000)));
+            }, child: const Text('Sorpréndeme')),
+            if (style != null)
+              TextButton(onPressed: () => onChanged({'theme': theme, 'name_style': null}), child: const Text('Eliminar estilo')),
+          ],
+        ],
+      ],
+    );
+  }
+
+  Widget _choice(String label, String value, Map<String, String> options, ValueChanged<String> onChanged) {
+    return Row(
+      mainAxisAlignment: MainAxisAlignment.spaceBetween,
+      children: [
+        Text(label),
+        DropdownButton<String>(
+          value: options.containsKey(value) ? value : options.keys.first,
+          items: options.entries.map((option) => DropdownMenuItem(value: option.key, child: Text(option.value))).toList(),
+          onChanged: (value) { if (value != null) onChanged(value); },
+        ),
+      ],
+    );
+  }
+}
+
+
+class _ProfileColorSwatch extends StatelessWidget {
+  const _ProfileColorSwatch({required this.label, required this.value, required this.onChanged});
+
+  final String label;
+  final int value;
+  final ValueChanged<int> onChanged;
+
+  @override
+  Widget build(BuildContext context) {
+    final color = _color(value);
+    return Column(
+      crossAxisAlignment: CrossAxisAlignment.stretch,
+      children: [
+        FilledButton(
+          style: FilledButton.styleFrom(
+            backgroundColor: color,
+            foregroundColor: color.computeLuminance() > .45 ? Colors.black : Colors.white,
+            minimumSize: const Size(0, 54),
+          ),
+          onPressed: () async {
+            final selected = await showProfileColorPicker(context, value);
+            if (context.mounted && selected != null) onChanged(selected);
+          },
+          child: const PhosphorIcon(PhosphorIconsBold.pencilSimple, size: 20),
+        ),
+        const SizedBox(height: 6),
+        Text(label, textAlign: TextAlign.center),
+      ],
+    );
+  }
+}
+
